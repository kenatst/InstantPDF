    "Conversions run locally on your device. Your documents are never uploaded or tracked." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konvertierungen laufen lokal auf Ihrem Gerät. Ihre Dokumente werden niemals hochgeladen oder verfolgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversions run locally on your device. Your documents are never uploaded or tracked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conversiones se ejecutan localmente en tu dispositivo. Tus documentos nunca se suben ni se rastrean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conversions s'exécutent localement sur votre appareil. Vos documents ne sont jamais transférés ni suivis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conversioni avvengono localmente sul tuo dispositivo. I tuoi documenti non vengono mai caricati né tracciati."
          }
        }
      }
    },
    "Conversions stay on your device.\nNo account. No tracking." : {
