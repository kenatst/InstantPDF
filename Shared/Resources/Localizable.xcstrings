    "%lld documents couldn't be saved to your Library. Your pages are kept — try again." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Dokumente konnten nicht in deiner Bibliothek gespeichert werden. Deine Seiten bleiben erhalten — versuch es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld documents couldn't be saved to your Library. Your pages are kept — try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron guardar %lld documentos en tu biblioteca. Tus páginas se conservan; inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld documents n'ont pas pu être enregistrés dans votre bibliothèque. Vos pages sont conservées — réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld documenti non sono stati salvati nella tua libreria. Le pagine sono al sicuro — riprova."
          }
        }
      }
