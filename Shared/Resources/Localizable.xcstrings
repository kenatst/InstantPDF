    "Adds a small footer to generated text and article PDFs. Existing PDFs are never modified.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt generierten Text- und Artikel-PDFs eine dezente Fußzeile hinzu. Vorhandene PDFs werden niemals verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a small footer to generated text and article PDFs. Existing PDFs are never modified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un pie de página discreto a los PDF de texto y artículos generados. Los PDF existentes nunca se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un pied de page discret aux PDF de texte et d'articles générés. Les PDF existants ne sont jamais modifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un piè di pagina discreto ai PDF generati da testo e articoli. I PDF esistenti non vengono mai modificati."
          }
        }
      }
    },
