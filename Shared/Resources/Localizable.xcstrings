    "PDF It processes and stores documents locally. Your documents are not uploaded to PDF It. When you convert a webpage, PDF It loads the page directly from its source website." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF It processes and stores documents locally. Your documents are not uploaded to PDF It. When you convert a webpage, PDF It loads the page directly from its source website."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF It traite et stocke les documents localement. Vos documents ne sont pas téléversés vers PDF It. Lorsque vous convertissez une page web, PDF It la charge directement depuis son site source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF It procesa y almacena documentos localmente. Tus documentos no se suben a PDF It. Cuando conviertes una página web, PDF It la carga directamente desde su sitio web de origen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF It verarbeitet und speichert Dokumente lokal. Ihre Dokumente werden nicht zu PDF It hochgeladen. Wenn Sie eine Webseite konvertieren, lädt PDF It diese direkt von der Quell-Website."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF It elabora e memorizza i documenti localmente. I tuoi documenti non vengono caricati su PDF It. Quando converti una pagina web, PDF It la carica direttamente dal sito web di origine."
          }
        }
      }
    },
