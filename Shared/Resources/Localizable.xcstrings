    "Some sites (login walls, CAPTCHAs, blurred previews) can't produce clean PDFs. If that happens, PDF It tells you instead of saving a bad file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Seiten (Login-Wände, CAPTCHAs, unscharfe Vorschauen) ergeben keine sauberen PDFs. Dann sagt dir PDF It Bescheid, statt eine schlechte Datei zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some sites (login walls, CAPTCHAs, blurred previews) can't produce clean PDFs. If that happens, PDF It tells you instead of saving a bad file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos sitios (muros de login, CAPTCHAs, vistas borrosas) no generan PDFs limpios. Si ocurre, PDF It te avisa en lugar de guardar un archivo malo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains sites (murs de connexion, CAPTCHA, aperçus flous) ne permettent pas un PDF propre. Dans ce cas, PDF It vous prévient au lieu d'enregistrer un mauvais fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni siti (login wall, CAPTCHA, anteprime sfocate) non producono PDF puliti. In tal caso PDF It te lo dice invece di salvare un file scarso."
          }
        }
      }
    },
    "Some sites (login walls, CAPTCHAs, blurred previews) don't allow clean captures. Try Reader mode, or convert the page from your browser instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Seiten (Login-Wände, CAPTCHAs, unscharfe Vorschauen) erlauben keine sauberen Aufnahmen. Nutze den Lesemodus oder konvertiere die Seite im Browser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some sites (login walls, CAPTCHAs, blurred previews) don't allow clean captures. Try Reader mode, or convert the page from your browser instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos sitios (muros de inicio de sesión, CAPTCHAs, vistas borrosas) no permiten capturas limpias. Prueba el modo Lectura o convierte la página desde tu navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains sites (murs de connexion, CAPTCHA, aperçus flous) ne permettent pas une capture propre. Essayez le mode Lecture ou convertissez la page depuis votre navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni siti (login wall, CAPTCHA, anteprime sfocate) non permettono acquisizioni pulite. Prova la modalità Lettura o converti la pagina dal browser."
