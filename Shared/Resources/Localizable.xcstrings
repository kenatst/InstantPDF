    "PDF It processes and stores documents locally. Your documents are not uploaded to PDF It. When you convert a webpage, PDF It loads the page directly from its source website." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFIT verarbeitet und speichert Dokumente lokal. Ihre Dokumente werden nicht zu PDFIT hochgeladen. Wenn Sie eine Webseite konvertieren, lädt PDFIT diese direkt von der Quell-Website."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFIT processes and stores documents locally. Your documents are not uploaded to PDFIT. When you convert a webpage, PDFIT loads the page directly from its source website."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFIT procesa y almacena documentos localmente. Tus documentos no se suben a PDFIT. Cuando conviertes una página web, PDFIT la carga directamente desde su sitio web de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFIT traite et stocke les documents localement. Vos documents ne sont pas téléversés vers PDFIT. Lorsque vous convertissez une page web, PDFIT la charge directement depuis son site source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFIT elabora e memorizza i documenti localmente. I tuoi documenti non vengono caricati su PDFIT. Quando converti una pagina web, PDFIT la carica direttamente dal sito web di origine."
          }
        }
      }
    },
    "PDF It receives only the content the source app chooses to share." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFIT erhält nur die Inhalte, die die Quell-App teilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFIT receives only the content the source app chooses to share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFIT solo recibe el contenido que la app origen decide compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFIT ne reçoit que le contenu que l'app source choisit de partager."
